{
  "name": "irudd-factory",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "vp run typecheck && vp run build:console",
    "build:console": "vp -C apps/console build",
    "check": "vp check && tsc --noEmit",
    "fixture": "vp run build:console && node apps/service/src/fixture-main.ts",
    "format": "vp fmt --check",
    "format:write": "vp fmt --write",
    "test": "vp test",
    "test:application": "vp test packages/application",
    "test:codex": "vp test packages/codex",
    "test:contracts": "vp test packages/contracts",
    "test:github": "vp test packages/github",
    "test:integration": "node apps/service/src/integration-main.ts",
    "test:state-sqlite": "vp test packages/state-sqlite",
    "test:workspaces": "vp test packages/workspaces",
    "test:service": "vp test apps/service",
    "test:cli": "vp test apps/cli",
    "test:console": "vp test apps/console",
    "typecheck": "tsc --noEmit",
    "prepare": "vp config"
  },
  "dependencies": {
    "@effect/platform": "0.97.1",
    "@effect/platform-node": "0.108.1",
    "@effect/rpc": "0.76.2",
    "effect": "3.22.1"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "5.9.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vite-plus": "0.3.0"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@11.25.0"
}
