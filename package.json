{
  "name": "irudd-factory",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "vp run typecheck && vp run build:console",
    "build:console": "vp -C apps/console build",
    "check": "vp check && tsc --noEmit",
    "fixture": "vp run build:console && bun run apps/service/src/fixture-main.ts",
    "format": "vp fmt --check",
    "format:write": "vp fmt --write",
    "test": "bun scripts/test-suite.ts all",
    "test:application": "bun scripts/test-suite.ts packages/application",
    "test:codex": "bun scripts/test-suite.ts packages/codex",
    "test:contracts": "bun scripts/test-suite.ts packages/contracts",
    "test:github": "bun scripts/test-suite.ts packages/github",
    "test:state-sqlite": "bun scripts/test-suite.ts packages/state-sqlite",
    "test:workspaces": "bun scripts/test-suite.ts packages/workspaces",
    "test:service": "bun scripts/test-suite.ts apps/service",
    "test:cli": "bun scripts/test-suite.ts apps/cli",
    "test:console": "bun scripts/test-suite.ts apps/console",
    "typecheck": "tsc --noEmit",
    "prepare": "vp config"
  },
  "dependencies": {
    "@effect/platform": "0.97.1",
    "@effect/platform-bun": "0.91.2",
    "@effect/rpc": "0.76.2",
    "effect": "3.22.1"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.9.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "catalog:"
  },
  "packageManager": "bun@1.3.14",
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vite-plus": "0.3.0"
  }
}
