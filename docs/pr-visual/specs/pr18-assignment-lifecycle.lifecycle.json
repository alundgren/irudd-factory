    { "id": "startup-failed", "from": "starting", "to": "failed", "variant": "security", "fromSide": "bottom", "toSide": "top" },
    { "id": "run-failed", "from": "running", "to": "failed", "variant": "security", "fromSide": "bottom", "toSide": "top" },
    { "id": "verification-failed", "from": "verify", "to": "failed", "variant": "security", "fromSide": "bottom", "toSide": "top" }
